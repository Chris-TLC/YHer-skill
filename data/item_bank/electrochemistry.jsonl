{"item_id": "ec-sample-001", "source": "样例题（电化学·电极方程式守恒）", "region": "全国卷", "year": 2024, "difficulty": "T2", "question_type": "解答题-化学反应原理（综合）", "kg_nodes": ["电化学", "氧化还原"], "stem": "用惰性电极电解 CuSO₄ 溶液一段时间。(1) 写出阴极、阳极的电极反应式。(2) 电解一段时间后溶液 pH 如何变化？请说明理由。", "sub_questions": [{"sub_id": "(1)", "stem": "写阴阳极电极反应式", "answer": "阴极：Cu²⁺+2e⁻=Cu；阳极：2H₂O-4e⁻=O₂↑+4H⁺", "score": 4.0}, {"sub_id": "(2)", "stem": "pH变化及理由", "answer": "pH减小（变酸）。阳极水放电生成 H⁺，溶液中 H⁺ 增多，故 pH 减小。", "score": 3.0}], "standard_solution": {"final_answers": ["阴极 Cu²⁺+2e⁻=Cu；阳极 2H₂O-4e⁻=O₂↑+4H⁺", "pH减小"], "solution_steps": [{"step": 1, "action": "判断阴极：阳离子放电顺序，Cu²⁺先于H⁺得电子", "result": "阴极 Cu²⁺+2e⁻=Cu", "formula": "阴极还原"}, {"step": 2, "action": "判断阳极：惰性电极，溶液中无活泼阴离子放电，水放电", "result": "阳极 2H₂O-4e⁻=O₂↑+4H⁺", "formula": "阳极氧化"}, {"step": 3, "action": "检查守恒：元素守恒、电荷守恒、电子守恒（阴阳极转移电子数相等）", "result": "两式电子数配平", "formula": "电子守恒"}, {"step": 4, "action": "分析pH：阳极生成H⁺，溶液酸性增强", "result": "pH减小", "formula": "H⁺增多→pH减小"}], "key_insight": "核心：阳极惰性电极时是水放电生成O₂和H⁺，不是SO₄²⁻放电。H⁺生成导致pH减小。"}, "rubric": [{"point_id": "sp1", "desc": "阴极反应正确（Cu²⁺得电子）", "keywords": ["Cu²⁺+2e", "Cu2++2e", "阴极", "Cu"], "score": 2.0, "must_have": true, "kg_node": "电化学"}, {"point_id": "sp2", "desc": "阳极反应正确（水放电生成O₂和H⁺）", "keywords": ["H₂O-4e", "H2O-4e", "O₂", "O2", "H⁺", "H+"], "score": 2.0, "must_have": true, "kg_node": "电化学"}, {"point_id": "sp3", "desc": "判断pH减小", "keywords": ["pH减小", "pH降低", "变酸", "酸性增强"], "score": 1.5, "must_have": true, "kg_node": "电化学"}, {"point_id": "sp4", "desc": "理由：阳极生成H⁺", "keywords": ["H⁺", "H+", "阳极", "生成"], "score": 1.5, "must_have": false, "kg_node": "电化学"}], "yihuier_chunk_ids": [], "videos": [{"bv": "BV1UM411y7vc", "p_number": 1, "completion_criterion": "看到电解装置能3步判断电极反应并检查守恒"}], "traps": ["阳极误判为SO₄²⁻放电", "正负极与阴阳极混淆", "电极方程式电子数不守恒"]}
